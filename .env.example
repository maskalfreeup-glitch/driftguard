# ==============================================================================
# DriftGuard - Production Environment Configuration Template
# ==============================================================================

# --- Primary EVM RPC Provider ---
PRIMARY_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIMARY_RPC_HOST=ethereum-sepolia-rpc.publicnode.com
PRIMARY_RPC_PORT=443

# --- Backup EVM RPC Provider (Automatic Failover Target) ---
BACKUP_RPC_URL=https://sepolia.gateway.tenderly.co
BACKUP_RPC_HOST=sepolia.gateway.tenderly.co
BACKUP_RPC_PORT=443

# --- Canonical Reference RPC (Trusted source of chain head truth) ---
CANONICAL_RPC_URL=https://rpc.sepolia.ethpandaops.io

# --- Drift Detection & Circuit Breaker Tuning ---
DRIFT_THRESHOLD=2            # Max allowable block discrepancy before draining
POLL_INTERVAL=4.0            # Seconds between health checks
RPC_TIMEOUT=3.5              # Seconds before timing out an upstream RPC query
FAILURE_THRESHOLD=2          # Consecutive failed checks to declare UNHEALTHY
RECOVERY_THRESHOLD=2         # Consecutive successful checks to declare HEALTHY

# --- HAProxy Gateway Security & Rate Limiting ---
RATE_LIMIT_PER_10S=200       # Max requests per 10 seconds per client IP
STATS_USER=admin             # Username for HAProxy stats UI (:8404/stats)
STATS_PASSWORD=driftguard_admin_secure_pass  # Password for HAProxy stats UI

# --- Redis Telemetry & State Persistence ---
REDIS_PASSWORD=driftguard_redis_secure_pass
REDIS_URL=redis://:driftguard_redis_secure_pass@redis:6379/0
REDIS_TIMEOUT=2.0
HISTORY_LIMIT=100

# --- Sentinel Daemon Settings ---
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
LOG_LEVEL=INFO
