# Multi-chain routing and health policy
CHAINS_CONFIG_PATH=sentinel/config/chains.yaml
MAX_REFERENCE_AGE=10
RPC_TIMEOUT=3.5
FAILURE_THRESHOLD=2
RECOVERY_THRESHOLD=2

# Authenticated Reference Anchors (overrides chains.yaml reference_url when set)
ANCHOR_ARB_ONE=
ANCHOR_ARB_NOVA=
ANCHOR_ARB_SEPOLIA=

# Gateway and observability
GATEWAY_PORT=8545
GATEWAY_BIND=127.0.0.1
HAPROXY_STATS_PORT=8404
RATE_LIMIT_PER_10S=200
STATS_USER=admin
STATS_PASSWORD=

# Redis secrets are required by Compose. Generate unique values locally.
REDIS_PASSWORD=
REDIS_TIMEOUT=2.0
HISTORY_LIMIT=100

# Chaos routes return 404 until a token is configured.
DRIFTGUARD_ADMIN_TOKEN=

# Used by scripts/test_gateway.sh for the Sepolia route.
EXPECTED_CHAIN_ID=11155111

# Optional Discord alerting. Treat this webhook URL as a secret.
DISCORD_WEBHOOK_URL=

# Sentinel service
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
LOG_LEVEL=INFO
