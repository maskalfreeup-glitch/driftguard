{"version": 2, "width": 100, "height": 30, "timestamp": 1791041535, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}, "title": "DriftGuard - Arbitrum Zero-Downtime RPC Failover Demo"}
[0.009167, "o", "\u001b[1m======================================================================\u001b[0m\r\n\u001b[1m   DriftGuard — Arbitrum L2/L3 Consensus & Nitro Sequence Guardian    \u001b[0m\r\n\u001b[1m      Transparent Failover & Sentinel Consensus Verification Demo     \u001b[0m\r\n\u001b[1m======================================================================\u001b[0m\r\n"]
[1.510789, "o", "\r\n\u001b[1m[Step 1/5] Querying live Arbitrum One head through DriftGuard edge...\u001b[0m\r\n"]
[1.511015, "o", "\u001b[0;36m$ curl -s -i -X POST https://rpc.maskal.space/arb \\\r\n  -H \"Content-Type: application/json\" \\\r\n  -d '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'\u001b[0m\r\n"]
[3.319177, "o", "HTTP/2 200 \r\r\nx-upstream: primary\r\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x1e7a7200\"}\r\n"]
[3.322206, "o", "\u001b[0;32m✔ Request served by Primary upstream (arb1.arbitrum.io)\u001b[0m\r\n"]
[5.32403, "o", "\r\n\u001b[1m[Step 2/5] Verifying Sentinel live consensus & drift monitor state...\u001b[0m\r\n\u001b[0;36m$ curl -s https://rpc.maskal.space/healthz | jq .\u001b[0m\r\n"]
[7.404854, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"OK\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"uptime_seconds\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m243.5\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"arbitrum_one\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"arbitrum-one\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"chain_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m42161\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"backend\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"be_arb\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"reference\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"endpoint_host\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"arbitrum.gateway.tenderly.co\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"HEALTHY\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Healthy\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"block\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m511341063\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"chain_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m42161\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"syncing_checked\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mfalse\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"drift\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"primary\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"endpoint_host\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"arb1.arbitrum.io\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"HEALTHY\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Healthy\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"block\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m511341061\u001b[0m\u001b[1;39m,\r\n"]
[7.405041, "o", "      \u001b[0m\u001b[1;34m\"chain_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m42161\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"syncing_checked\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"drift\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"fallback\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"endpoint_host\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"arbitrum-one-rpc.publicnode.com\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"HEALTHY\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Healthy\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"block\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m511341063\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"chain_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m42161\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"syncing_checked\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"drift\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[7.405392, "o", "\u001b[0;32m✔ Sentinel active: Primary and Fallback synchronized with canonical reference\u001b[0m\r\n"]
[9.407162, "o", "\r\n\u001b[1m[Step 3/5] Draining primary node via Sentinel socket (simulating 50-block desync)...\u001b[0m\r\n"]
[9.40755, "o", "\u001b[0;36m$ curl -s -X POST \"http://sentinel:8000/admin/simulate?backend=be_arb&node=primary&drift=50\" \\\r\n  -H \"Authorization: Bearer [ADMIN_TOKEN]\"\u001b[0m\r\n"]
[14.975736, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"FAULT_INJECTED\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"node\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"primary\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"chain\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"backend\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"be_arb\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"drift\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m50\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"fault\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[14.976687, "o", "\u001b[1;33m⚡ Primary node drained to MAINT mode via HAProxy UNIX domain socket.\u001b[0m\r\n"]
[16.478549, "o", "\r\n\u001b[1m[Step 4/5] Immediate subsequent curl during blackout (transparent failover)...\u001b[0m\r\n"]
[16.478746, "o", "\u001b[0;36m$ curl -s -i -X POST https://rpc.maskal.space/arb \\\r\n  -H \"Content-Type: application/json\" \\\r\n  -d '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'\u001b[0m\r\n"]
[18.426626, "o", "HTTP/2 200 \r\r\nx-upstream: fallback\r\r\n{\"jsonrpc\":\"2.0\",\"result\":\"0x1e7a7238\",\"id\":1}\r\n"]
[18.429166, "o", "\u001b[0;32m✔ Zero dropped requests: Fallback served canonical block with HTTP 200 OK!\u001b[0m\r\n"]
[20.430869, "o", "\r\n\u001b[1m[Step 5/5] Restoring Primary upstream back to synchronized healthy state...\u001b[0m\r\n"]
[20.431066, "o", "\u001b[0;36m$ curl -s -X POST \"http://sentinel:8000/admin/reset?backend=be_arb\" \\\r\n  -H \"Authorization: Bearer [ADMIN_TOKEN]\"\u001b[0m\r\n"]
[26.598233, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"FAULTS_RESET\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[28.661148, "o", "HTTP/2 200 \r\r\nx-upstream: primary\r\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x1e7a725b\"}\r\n"]
[28.664121, "o", "\u001b[0;32m✔ Primary node restored to active routing pool.\u001b[0m\r\n"]
[30.165752, "o", "\r\n\u001b[1m======================================================================\u001b[0m\r\n\u001b[0;32m\u001b[1m✔ Demo Complete: Sub-130ms failover, 0 dropped queries, full consensus integrity.\u001b[0m\r\n\u001b[1m======================================================================\u001b[0m\r\n"]
